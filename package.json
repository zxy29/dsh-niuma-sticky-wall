{
  "name": "dsh-niuma-sticky-wall",
  "version": "1.0.0",
  "type": "module",
  "description": "牛马便签墙 / Sticky Wall for DeepSeek Harness: a sidebar wall of colored notes, one paper color and one calendar day per note, grouped by day, searchable, plus a task_records agent tool over the same list.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sticky-notes",
    "notes",
    "wall",
    "sidebar"
  ],
  "license": "MIT",
  "icon": "./icon.svg",
  "homepage": "https://github.com/zxy29/dsh-niuma-sticky-wall#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zxy29/dsh-niuma-sticky-wall.git"
  },
  "bugs": {
    "url": "https://github.com/zxy29/dsh-niuma-sticky-wall/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "prepublishOnly": "npm run check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
